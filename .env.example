# Required by the app for Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Used by the local demo seeder only. Server-side only; never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
DEMO_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=replace_with_local_demo_password
